# Example secrets file.
#
# HOW TO USE THIS
#   Local  : copy this file to .streamlit/secrets.toml and fill it in.
#            That path is in .gitignore, so it never reaches GitHub.
#   Deployed: do not upload anything. Open your app on Streamlit Community
#            Cloud, go to Settings -> Secrets, and paste the same line there.
#
# WHAT IT IS FOR
#   OpenAlex runs a faster, more reliable "polite pool" for API requests that
#   identify themselves with a contact email. This is entirely optional - the
#   dashboard works without it, just in the slower anonymous pool.
#
#   Keeping the address here instead of in openalex.py means the code can go
#   into a public repository without the email going with it.

openalex_email = "you@example.com"
